{
  "name": "Feather UI",
  "scopeName": "source.feather-fui",
  "patterns": [
    { "name": "comment.line.double-slash.feather", "match": "//.*$" },
    { "name": "comment.block.feather", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.feather", "begin": "\"", "end": "\"" },
    { "name": "keyword.control.feather", "match": "\\b(?:if|else|for|in|state|import)\\b" },
    { "name": "constant.language.boolean.feather", "match": "\\b(?:true|false)\\b" },
    { "name": "constant.numeric.feather", "match": "-?\\b[0-9]+(?:\\.[0-9]+)?\\b" },
    { "name": "support.type.widget.feather", "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*[(\\{])" },
    { "name": "variable.parameter.feather", "match": "\\b[A-Za-z][A-Za-z0-9_]*\\b(?=\\s*:)" },
    { "name": "keyword.operator.feather", "match": "[+*/-]|==|!=|[<>]=?|&&|\\|\\||=" }
  ]
}
